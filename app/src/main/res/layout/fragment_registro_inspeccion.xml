<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tejisur_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/margin_screen">

    <TextView
        android:id="@+id/tvTituloInspeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/placeholder_registro_inspeccion_titulo"
        android:textColor="@color/tejisur_text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescripcionInspeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_label"
        android:gravity="center"
        android:text="@string/placeholder_registro_inspeccion_descripcion"
        android:textColor="@color/tejisur_text_secondary"
        android:textSize="@dimen/text_body" />

</LinearLayout>

