<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_small"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvGrupo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tejisur_primary"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerTipo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/inspeccion_tipo_defecto" />

    <Spinner
        android:id="@+id/spinnerCausa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/inspeccion_causa_defecto" />

    <Spinner
        android:id="@+id/spinnerDisposicion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/inspeccion_disposicion_defecto" />

    <EditText
        android:id="@+id/etCantidad"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/inspeccion_prendas_afectadas"
        android:inputType="number" />

    <Button
        android:id="@+id/btnQuitarCausa"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/inspeccion_quitar_grupo"
        android:textAllCaps="false" />
</LinearLayout>
