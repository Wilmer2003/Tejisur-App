<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_label"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="@dimen/padding_card">

    <TextView
        android:id="@+id/tvTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tejisur_primary"
        android:textSize="@dimen/text_value"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCausa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_label"
        android:textColor="@color/tejisur_text_secondary"
        android:textSize="@dimen/text_label" />

    <TextView
        android:id="@+id/tvDisposicion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_label"
        android:textColor="@color/tejisur_text_primary"
        android:textSize="@dimen/text_label" />

    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_label"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="@dimen/margin_label"
        android:paddingVertical="@dimen/margin_small"
        android:textSize="@dimen/text_label"
        android:textStyle="bold" />
</LinearLayout>
